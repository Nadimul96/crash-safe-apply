{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"noEmit": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"exactOptionalPropertyTypes": false,
		"skipLibCheck": true,
		"types": ["node"]
	},
	"include": ["bin", "src", "test", "scripts"]
}
